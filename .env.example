# ==========================================
# SUPABASE CONFIGURATION FOR CODESTACK SCHEDULE
# ==========================================
# Panduan Setup:
# 1. Buat project baru di https://supabase.com
# 2. Buka menu Project Settings -> API
# 3. Salin Project URL ke VITE_SUPABASE_URL
# 4. Salin anon public API Key ke VITE_SUPABASE_ANON_KEY
# 5. Jalankan script SQL dari file 'supabase/schema.sql' di Supabase SQL Editor

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
